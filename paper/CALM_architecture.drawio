<mxfile host="app.diagrams.net" type="device">
  <diagram id="calm-arch" name="CALM Architecture">
    <mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="660" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="CALM: a label-efficient, calibrated, order-invariant medical-QA framework on 2&#215;T4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=3;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="24" width="1320" height="46" as="geometry" />
        </mxCell>

        <!-- Left: data + retained student -->
        <mxCell id="seed" value="Seed labels&#10;(500–4000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5FA3;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#10243F;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="180" height="92" as="geometry" />
        </mxCell>
        <mxCell id="student" value="QLoRA student&#10;Qwen2.5 3B / 7B&#10;(4-bit, supervised)&#10;— retained backbone —" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D32;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#14391A;" vertex="1" parent="1">
          <mxGeometry x="300" y="284" width="240" height="124" as="geometry" />
        </mxCell>

        <!-- Self-distillation container (tested, NOT retained) -->
        <mxCell id="sd" value="Teacher-guided self-distillation  —  tested, NOT retained (negative result)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#9AA0A6;strokeWidth=2;verticalAlign=bottom;spacingBottom=8;fontSize=13;fontStyle=2;fontColor=#6B7075;" vertex="1" parent="1">
          <mxGeometry x="600" y="96" width="470" height="350" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="Teacher: HuatuoGPT-o1-7B (4-bit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C98A00;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#5A4200;" vertex="1" parent="1">
          <mxGeometry x="675" y="126" width="320" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pseudo" value="Forced-answer +&#10;permutation-gate&#10;pseudo-labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C98A00;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#5A4200;" vertex="1" parent="1">
          <mxGeometry x="630" y="222" width="190" height="92" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Note memory&#10;(rationale retrieval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C98A00;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#5A4200;" vertex="1" parent="1">
          <mxGeometry x="850" y="222" width="190" height="92" as="geometry" />
        </mxCell>
        <mxCell id="kd" value="Soft-label KD + short GRPO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#9AA0A6;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#3C4043;" vertex="1" parent="1">
          <mxGeometry x="710" y="350" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- CALM inference core (retained) -->
        <mxCell id="core" value="CALM inference core (retained)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontStyle=2;fontColor=#A02C28;" vertex="1" parent="1">
          <mxGeometry x="1140" y="150" width="220" height="384" as="geometry" />
        </mxCell>
        <mxCell id="readout" value="Order-invariant readout&#10;4× cyclic marginalization&#10;(acc 0.633 → 0.655)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A3FA0;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#3E2370;" vertex="1" parent="1">
          <mxGeometry x="1155" y="188" width="190" height="88" as="geometry" />
        </mxCell>
        <mxCell id="temp" value="Temperature scaling&#10;(ECE 0.086 → 0.026)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#7A1F1C;" vertex="1" parent="1">
          <mxGeometry x="1155" y="296" width="190" height="62" as="geometry" />
        </mxCell>
        <mxCell id="sel" value="Selective prediction&#10;answer / abstain&#10;(81% acc @ 50% coverage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#7A1F1C;" vertex="1" parent="1">
          <mxGeometry x="1155" y="378" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="routing" value="+ reflective routing&#10;(reason on ~2% unsure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=1;fontSize=12;fontStyle=0;fontColor=#7A1F1C;" vertex="1" parent="1">
          <mxGeometry x="1155" y="476" width="190" height="46" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_seed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#3C4043;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="seed" target="student"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_tp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#C98A00;strokeWidth=2;exitX=0.35;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="teacher" target="pseudo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_tn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#C98A00;strokeWidth=2;exitX=0.65;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="teacher" target="note"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_np" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;dashPattern=4 4;strokeColor=#9AA0A6;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="note" target="pseudo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#3C4043;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="pseudo" target="kd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sp" value="mine hard items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#3C4043;strokeWidth=2;fontSize=12;fontColor=#5F6368;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="student" target="pseudo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_refine" value="refine (not retained)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;dashPattern=6 6;strokeColor=#2F7D32;strokeWidth=2;fontSize=12;fontStyle=2;fontColor=#2F7D32;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.85;entryY=1;" edge="1" parent="1" source="kd" target="student">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="835" y="470" /><mxPoint x="504" y="470" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_ckpt" value="validation-selected (supervised) checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#111111;strokeWidth=2.5;fontSize=12;fontStyle=1;fontColor=#111111;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="student" target="readout">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="572" /><mxPoint x="1095" y="572" /><mxPoint x="1095" y="232" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_rt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="readout" target="temp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="temp" target="sel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sel" target="routing"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Blue: data      Green: student / training (retained)      Orange/grey: teacher self-distillation (tested, not retained)      Red: calibration + order-invariant readout + abstention (the working core)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F6368;" vertex="1" parent="1">
          <mxGeometry x="60" y="606" width="1300" height="26" as="geometry" />
